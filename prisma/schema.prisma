generator client {
  provider = "prisma-client-js"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  BUYER
  VENDOR
  ADMIN
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum VendorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum VendorStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  IN_FULFILMENT
  COMPLETED
  PAYMENT_REJECTED
  CANCELLED
  EXPIRED
}

enum VendorOrderStatus {
  PENDING_PAYMENT
  NEW
  CONFIRMED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum SettlementStatus {
  PENDING
  ELIGIBLE_AFTER_DELIVERY
  SETTLED
}

enum PaymentMethod {
  BANK_TRANSFER
}

enum PaymentStatus {
  AWAITING_SUBMISSION
  SUBMITTED
  VERIFIED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  VENDOR
  SYSTEM
}

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============================================================
// USER
// ============================================================

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  phoneE164       String?       @unique @map("phone_e164")
  fullName        String        @map("full_name")
  passwordHash    String        @map("password_hash")
  role            UserRole
  adminRole       AdminRole?    @map("admin_role")
  accountStatus   AccountStatus @default(ACTIVE) @map("account_status")
  emailVerifiedAt DateTime?     @map("email_verified_at")
  lastLoginAt     DateTime?     @map("last_login_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Authentication
  refreshSessions RefreshSession[]

  // Vendor
  vendorApplications VendorApplication[]
  vendor             Vendor?

  // Shopping
  cart      Cart?
  addresses Address[]
  orders    Order[]

  // Notifications
  notifications Notification[]

  // Admin audit
  adminAuditLogs AdminAuditLog[]

  // Vendor application reviews
  reviewedVendorApplications VendorApplication[] @relation("VendorApplicationReviewer")

  // Vendor approvals
  approvedVendors Vendor[] @relation("VendorApprover")

  // Payment verification
  verifiedPayments Payment[] @relation("PaymentVerifier")

  // Admin invitations
  adminInvitationsSent AdminInvitation[] @relation("AdminInvitationSender")

  @@index([role, accountStatus])
  @@index([role, adminRole, accountStatus])
  @@map("users")
}

// ============================================================
// REFRESH SESSIONS
// ============================================================

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipHash    String?   @map("ip_hash")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

// ============================================================
// ADMIN INVITATION
// ============================================================

model AdminInvitation {
  id          String                @id @default(uuid())
  email       String
  tokenHash   String                @unique @map("token_hash")
  invitedById String                @map("invited_by_id")
  status      AdminInvitationStatus @default(PENDING)
  expiresAt   DateTime              @map("expires_at")
  acceptedAt  DateTime?             @map("accepted_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  invitedBy User @relation("AdminInvitationSender", fields: [invitedById], references: [id])

  @@index([email, status])
  @@index([invitedById])
  @@index([status, expiresAt])
  @@map("admin_invitations")
}

// ============================================================
// VENDOR APPLICATION
// ============================================================

model VendorApplication {
  id                String                  @id @default(uuid())
  userId            String                  @map("user_id")
  businessName      String                  @map("business_name")
  contactPhone      String                  @map("contact_phone")
  description       String?
  categoryNotes     String?                 @map("category_notes")
  verificationNotes String?                 @map("verification_notes")
  status            VendorApplicationStatus @default(PENDING)
  reviewedById      String?                 @map("reviewed_by")
  reviewedAt        DateTime?               @map("reviewed_at")
  rejectionReason   String?                 @map("rejection_reason")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VendorApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("vendor_applications")
}

// ============================================================
// VENDOR
// ============================================================

model Vendor {
  id            String       @id @default(uuid())
  userId        String       @unique @map("user_id")
  businessName  String       @map("business_name")
  slug          String       @unique
  status        VendorStatus @default(ACTIVE)
  approvedAt    DateTime?    @map("approved_at")
  approvedById  String?      @map("approved_by")
  contactPhone  String       @map("contact_phone")
  pickupAddress String?      @map("pickup_address")
  deliveryNotes String?      @map("delivery_notes")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("VendorApprover", fields: [approvedById], references: [id])

  products          Product[]
  vendorOrderGroups VendorOrderGroup[]

  @@index([status, businessName])
  @@map("vendors")
}

// ============================================================
// CATEGORY
// ============================================================

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

// ============================================================
// PRODUCT
// ============================================================

model Product {
  id            String        @id @default(uuid())
  vendorId      String        @map("vendor_id")
  categoryId    String        @map("category_id")
  name          String
  description   String
  priceAmount   Decimal       @map("price_amount") @db.Decimal(12, 2)
  currency      String        @default("NGN")
  stockOnHand   Int           @map("stock_on_hand")
  stockReserved Int           @default(0) @map("stock_reserved")
  status        ProductStatus @default(DRAFT)
  isAvailable   Boolean       @default(false) @map("is_available")
  publishedAt   DateTime?     @map("published_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  images            ProductImage[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([vendorId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@map("products")
}

// ============================================================
// PRODUCT IMAGE
// Maximum 5 images per product is enforced at service/database
// level because Prisma schema does not support COUNT constraints.
// ============================================================

model ProductImage {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  storageKey String   @unique @map("storage_key")
  url        String
  altText    String?  @map("alt_text")
  position   Int
  width      Int?
  height     Int?
  bytes      Int?
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@map("product_images")
}

// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(uuid())
  buyerId   String   @unique @map("buyer_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buyer User @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  items CartItem[]

  @@map("carts")
}

// ============================================================
// CART ITEM
// ============================================================

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  productId String   @map("product_id")
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ============================================================
// ADDRESS
// ============================================================

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  label         String?
  recipientName String   @map("recipient_name")
  phone         String
  areaCode      String?  @map("area_code")
  addressLine   String   @map("address_line")
  instructions  String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ============================================================
// ORDER
// ============================================================

model Order {
  id                      String        @id @default(uuid())
  orderNumber             String        @unique @map("order_number")
  buyerId                 String        @map("buyer_id")
  currency                String        @default("NGN")
  subtotalAmount          Decimal       @map("subtotal_amount") @db.Decimal(12, 2)
  deliveryAmount          Decimal       @map("delivery_amount") @db.Decimal(12, 2)
  totalAmount             Decimal       @map("total_amount") @db.Decimal(12, 2)
  paymentStatus           PaymentStatus @default(AWAITING_SUBMISSION) @map("payment_status")
  status                  OrderStatus   @default(AWAITING_PAYMENT)
  deliveryAddressSnapshot Json          @map("delivery_address_snapshot")
  placedAt                DateTime?     @map("placed_at")
  cancelledAt             DateTime?     @map("cancelled_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  buyer User @relation(fields: [buyerId], references: [id])

  vendorOrderGroups VendorOrderGroup[]
  payments          Payment[]
  stockReservations StockReservation[]

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

// ============================================================
// VENDOR ORDER GROUP
// ============================================================

model VendorOrderGroup {
  id               String            @id @default(uuid())
  orderId          String            @map("order_id")
  vendorId         String            @map("vendor_id")
  groupNumber      Int               @map("group_number")
  subtotalAmount   Decimal           @map("subtotal_amount") @db.Decimal(12, 2)
  deliveryAmount   Decimal           @map("delivery_amount") @db.Decimal(12, 2)
  commissionAmount Decimal           @map("commission_amount") @db.Decimal(12, 2)
  payoutAmount     Decimal           @map("payout_amount") @db.Decimal(12, 2)
  fulfilmentStatus VendorOrderStatus @default(PENDING_PAYMENT) @map("fulfilment_status")
  deliveryMethod   DeliveryMethod
  vendorNotes      String?           @map("vendor_notes")
  settlementStatus SettlementStatus  @default(PENDING) @map("settlement_status")
  settledAt        DateTime?         @map("settled_at")
  settledAmount    Decimal?          @map("settled_amount") @db.Decimal(12, 2)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id])

  orderItems OrderItem[]

  @@unique([orderId, vendorId])
  @@unique([orderId, groupNumber])
  @@index([vendorId, fulfilmentStatus, createdAt])
  @@map("vendor_order_groups")
}

// ============================================================
// ORDER ITEM
// ============================================================

model OrderItem {
  id                  String   @id @default(uuid())
  vendorOrderGroupId  String   @map("vendor_order_group_id")
  productId           String?  @map("product_id")
  productNameSnapshot String   @map("product_name_snapshot")
  unitPriceAmount     Decimal  @map("unit_price_amount") @db.Decimal(12, 2)
  quantity            Int
  lineTotalAmount     Decimal  @map("line_total_amount") @db.Decimal(12, 2)
  imageUrlSnapshot    String?  @map("image_url_snapshot")
  vendorNameSnapshot  String   @map("vendor_name_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")

  vendorOrderGroup VendorOrderGroup @relation(fields: [vendorOrderGroupId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id])

  @@index([vendorOrderGroupId])
  @@map("order_items")
}

// ============================================================
// STOCK RESERVATION
// stockReserved <= stockOnHand is enforced in service/database
// transaction logic.
// ============================================================

model StockReservation {
  id          String    @id @default(uuid())
  productId   String    @map("product_id")
  orderId     String    @map("order_id")
  quantity    Int
  expiresAt   DateTime  @map("expires_at")
  releasedAt  DateTime? @map("released_at")
  committedAt DateTime? @map("committed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([expiresAt])
  @@map("stock_reservations")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  method          PaymentMethod @default(BANK_TRANSFER)
  status          PaymentStatus @default(AWAITING_SUBMISSION)
  amount          Decimal       @db.Decimal(12, 2)
  bankReference   String?       @map("bank_reference")
  proofStorageKey String?       @map("proof_storage_key")
  submittedAt     DateTime?     @map("submitted_at")
  verifiedAt      DateTime?     @map("verified_at")
  verifiedById    String?       @map("verified_by")
  idempotencyKey  String        @unique @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  verifiedBy User? @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([verifiedById])
  @@map("payments")
}

// ============================================================
// ADMIN AUDIT LOG
// ============================================================

model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String   @map("admin_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  before      Json?
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([adminUserId, createdAt])
  @@map("admin_audit_logs")
}

// ============================================================
// NOTIFICATION
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
